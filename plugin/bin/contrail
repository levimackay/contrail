#!/bin/sh
# Runs the Contrail CLI with Bun if it is installed, otherwise with Node 22.13+.
here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
app="$here/dist/contrail.mjs"

if command -v bun >/dev/null 2>&1; then
  exec bun "$app" "$@"
fi
if command -v node >/dev/null 2>&1; then
  exec node --no-warnings "$app" "$@"
fi

# The Stop hook runs `ingest`; without a runtime the events simply wait in the spool.
[ "$1" = ingest ] && exit 0
msg="contrail: queries need Node 22.13+ or Bun, and neither is on PATH. Install one, then run this again. Recording still works in the meantime."
# A skill shows a failing command as a broken shell block, so there the message is the output.
for arg in "$@"; do
  if [ "$arg" = --from-skill ]; then
    echo "$msg"
    exit 0
  fi
done
echo "$msg" >&2
exit 127
